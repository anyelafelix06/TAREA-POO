public class j34 {

    public static void main(String[] args) {
        try {
            // Intentamos hacer una operación matemática inválida
            int resultado = 5 / 0;
            System.out.println(resultado);

        } catch (ArithmeticException e) {
            // Aquí gestionamos (atrapamos) el error localmente
            System.out.println("¡Atención! Ocurrió un error matemático: división entre cero.");
        }

        System.out.println("El programa continúa su ejecución normal gracias a la gestión local.");


        System.out.println("-----Calcular Grupo-----");
        try {
            int personas = 25;
            int grupos = 0;

            int promedio = personas / grupos;

            System.out.println("Personas por grupo: " + promedio);

        } catch (ArithmeticException e) {

            System.out.println("¡Error! No se puede dividir entre cero.");
            System.out.println("Detalle técnico: " + e.getMessage());
        }

        System.out.println("El programa continúa ejecutándose normalmente.");


    }
}
